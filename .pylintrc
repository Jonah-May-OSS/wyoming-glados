[MASTER]
init-hook='import sys, pathlib; sys.path.insert(0, str(pathlib.Path().resolve()))'
ignore=__pycache__,export_onnx.py

[BASIC]
const-rgx=^(_?[A-Z][A-Z0-9_]*|_?[a-z][a-z0-9_]*|__.*__)$
no-docstring-rgx=^(_|test_|Test|mock_|pytest_|setup_|teardown_)

[DESIGN]
# build_dataset takes 3 positional args plus 7 keyword-only tuning knobs,
# all defaulted. max-positional-arguments (7) is the cap that actually
# guards call-site readability here.
max-args=10
max-locals=25
max-branches=15
max-attributes=15
max-positional-arguments=7
max-returns=10
max-statements=70
min-public-methods=1

[EXCEPTIONS]
overgeneral-exceptions=builtins.BaseException

[SIMILARITIES]
min-similarity-lines=12

[FORMAT]
max-line-length=100
