[MASTER]
init-hook='import sys, pathlib; sys.path.insert(0, str(pathlib.Path().resolve()))'
ignore=__pycache__,export_onnx.py

[BASIC]
const-rgx=^(_?[A-Z][A-Z0-9_]*|_?[a-z][a-z0-9_]*|__.*__)$
no-docstring-rgx=^(_|test_|Test|mock_|pytest_|setup_|teardown_)

[DESIGN]
# build_dataset takes 3 positional args plus 7 keyword-only tuning knobs,
# all defaulted. max-positional-arguments (7) is the cap that actually
# guards call-site readability here.
max-args=10
max-locals=25
max-branches=15
# PiperTTSRunner carries one voice's entire runtime state: the two file
# paths, the loaded config and the four values read out of it (sample rate,
# espeak voice, noise_scale, noise_w), the session and its two capability
# flags, the phonemizer and its lock, and the speaker id. Cohesive, and
# splitting it into sub-objects would only add indirection between the config
# and the code that reads it.
max-attributes=18
max-positional-arguments=7
max-returns=10
max-statements=70
min-public-methods=1

[EXCEPTIONS]
overgeneral-exceptions=builtins.BaseException

[SIMILARITIES]
min-similarity-lines=12

[FORMAT]
max-line-length=100
