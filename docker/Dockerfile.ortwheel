# syntax=docker/dockerfile:1

# ===========================================================================
# Builds ONNX Runtime for aarch64 WITH the TensorRT execution provider.
#
# Why this exists: onnxruntime-gpu publishes no aarch64 wheel containing
# libonnxruntime_providers_tensorrt.so. Verified against the 1.29.0 release
# and the 1.30.0.dev20260901001 nightly - 354 entries each, CUDA provider and
# shared provider only. No flag, extra index or version bump turns it on, so
# TensorRT on ARM has to be compiled.
#
# This is NOT part of the image build. It is driven by
# .github/workflows/ort-aarch64-wheel.yml, which builds the wheel once per
# onnxruntime version and publishes it as a release asset; docker/Dockerfile
# then downloads that wheel. A release therefore never pays for this compile
# - only a version bump does, and it pays once rather than once per
# architecture per release.
#
# The NGC TensorRT image is the base because it carries exactly what a source
# build needs and the pip wheels do not: nvcc, the CUDA headers, cuDNN and
# NvInfer.h. It is multi-arch, so on an arm64 builder this resolves to the
# SBSA aarch64 variant.
# ===========================================================================
FROM nvcr.io/nvidia/tensorrt:26.02-py3 AS builder

# Same apt resilience as the image build: without a timeout apt can hang
# indefinitely on a half-open fetch.
RUN printf 'Acquire::Retries "3";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' > /etc/apt/apt.conf.d/99network-resilience \
    && apt-get update && apt-get install -y --no-install-recommends \
        git \
        build-essential \
        python3-dev \
        python3-pip \
        python3-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# CMake, from pip rather than apt, in its own prefix.
#
# ONNX Runtime's CMakeLists.txt requires >= 3.28. The NGC image already has
# cmake 3.24 at /usr/local/bin, which precedes /usr/bin on PATH, so
# apt-installing a newer one is silently ignored - the first attempt died in
# 0.24s with "CMake 3.28 or higher is required. You are running version
# 3.24.0" while a newer cmake sat unused in /usr/bin.
#
# A venv keeps it out of the way entirely instead of overwriting the base
# image's copy, and build.sh is pointed at it explicitly with --cmake_path.
RUN python3 -m venv /opt/cmake \
    && /opt/cmake/bin/pip install --no-cache-dir "cmake>=3.31" \
    && /opt/cmake/bin/cmake --version

# Pinned by the caller from requirements.txt, so the compiled wheel is always
# the same onnxruntime version the pin describes. A mismatch would put a
# different ONNX Runtime in the image than the requirements file claims.
# The base image's TensorRT major is not free to choose. The wheel built here
# links whatever libnvinfer the base provides, and at runtime the image
# resolves that against the tensorrt-cu13 pin in requirements.txt - which is
# on the 10.x line. Build on a TensorRT 11 base and the wheel needs
# libnvinfer.so.11 while the image ships libnvinfer.so.10, so the provider
# cannot load.
#
# That is not hypothetical: renovate bumped this base 26.02 -> 26.08 (PR
# 631), 26.08 ships TensorRT 11, and the mismatch surfaced as
#
#     libnvinfer.so.11 => not found
#     libnvonnxparser.so.11 => not found
#
# in the arm64 image build - after a 232-minute wheel build had already
# succeeded. This check costs seconds and fails at the top instead.
ARG TRT_SONAME_MAJOR=10
RUN set -eu; \
    if ! ldconfig -p | grep -q "libnvinfer.so.${TRT_SONAME_MAJOR}"; then \
      echo "This base provides:"; \
      ldconfig -p | grep -o 'libnvinfer.so.[0-9]*' | sort -u; \
      echo "but requirements.txt pins tensorrt-cu13 on the ${TRT_SONAME_MAJOR}.x line."; \
      echo "Move the base image and the tensorrt-cu13 pin together, or not at all."; \
      exit 1; \
    fi; \
    echo "base provides libnvinfer.so.${TRT_SONAME_MAJOR}, matching the pin"

ARG ORT_REF=v1.29.0

RUN git clone --depth 1 --branch "$ORT_REF" --recursive \
        https://github.com/microsoft/onnxruntime /src/onnxruntime

WORKDIR /src/onnxruntime

# --allow_running_as_root: this runs as root inside a container.
# --skip_tests: the suite needs a GPU, and no builder has one.
# --compile_no_warning_as_error: a release branch that warns on a newer
#   toolchain should not fail the build.
#
# The attention kernels are ON, and must stay on, even though VITS uses
# none of them. Turning them off does not work in ONNX Runtime 1.29:
#
#   core/providers/cuda/llm/attention.cc:39:49: error:
#   'kCutlassSafeMaskFilterValue' is not a member of
#   'onnxruntime::contrib::cuda'
#
# That constant is defined behind the attention options, and llm/attention.cc
# references it unconditionally, so USE_MEMORY_EFFICIENT_ATTENTION=OFF breaks
# the build. It is an upstream configuration bug, found the expensive way -
# 168 minutes in, at 81%. Do not re-add those flags without checking whether
# it has been fixed; the wasted kernels are the cheaper of the two options.
#
# Parallelism is capped for the same reason. A 4-core arm64 runner with 16 GB
# multiplies memory by build jobs AND by nvcc threads inside each, and the
# default (nproc x 4) is what ran the machine out. Slower per step, but a
# build that finishes beats a build that is killed at 50%.
#
# onnxruntime_BUILD_UNIT_TESTS=OFF is the big one. --skip_tests only skips
# RUNNING them; the test binaries are still compiled, and they are among the
# largest targets in the tree. A five-hour run died at 65% having just
# finished onnxruntime_unittest_utils - hours spent building code this image
# throws away, and quite possibly the failing target itself.
#
# CMAKE_CUDA_ARCHITECTURES: every architecture is compiled separately, so
# this is a direct multiplier on the longest step. Trimmed from four to the
# two that describe real arm64 GPU deployments for this project - 87 = Orin,
# 110 = Thor. Dropped: 90 (Hopper/GH200) and 100 (Blackwell/GB200), which
# are datacentre parts nobody is running a Home Assistant TTS on. Add them
# back here if that stops being true; the cost is build time, not
# correctness.
ARG CUDA_ARCHS=87;110
ARG BUILD_PARALLEL=2
ARG NVCC_THREADS=1
RUN ./build.sh \
        --cmake_path /opt/cmake/bin/cmake \
        --config Release --update --build \
        --build_wheel --skip_tests --allow_running_as_root \
        --compile_no_warning_as_error \
        --use_cuda --use_tensorrt \
        --cuda_home /usr/local/cuda --cudnn_home /usr --tensorrt_home /usr \
        --parallel "${BUILD_PARALLEL}" --nvcc_threads "${NVCC_THREADS}" \
        --cmake_extra_defines "CMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHS}" \
            onnxruntime_BUILD_UNIT_TESTS=OFF

# Fail here rather than shipping a wheel without the very provider this
# whole file exists to produce.
RUN set -eu; \
    mkdir -p /ortwheel; \
    cp build/Linux/Release/dist/*.whl /ortwheel/; \
    cd /ortwheel; \
    WHEEL="$(ls ./*.whl)"; \
    python3 -c "import sys, zipfile; \
names = zipfile.ZipFile(sys.argv[1]).namelist(); \
target = 'onnxruntime/capi/libonnxruntime_providers_tensorrt.so'; \
sys.exit(0) if target in names else sys.exit('built wheel has no ' + target)" \
      "$WHEEL"; \
    PROV=onnxruntime/capi/libonnxruntime_providers_tensorrt.so; \
    python3 -c "import sys, zipfile; open('/tmp/prov.so','wb').write( \
zipfile.ZipFile(sys.argv[1]).read(sys.argv[2]))" "$WHEEL" "$PROV"; \
    readelf -d /tmp/prov.so | grep -o 'libnvinfer.so.[0-9]*' | sort -u; \
    readelf -d /tmp/prov.so | grep -q "libnvinfer.so.${TRT_SONAME_MAJOR}" \
      || { echo "built provider does not link libnvinfer.so.${TRT_SONAME_MAJOR}"; \
           exit 1; }; \
    rm -f /tmp/prov.so; \
    sha256sum ./*.whl > SHA256SUMS.txt; \
    cat SHA256SUMS.txt

# Export stage: `--output type=local` on this yields just the wheel and its
# checksum file, not the multi-gigabyte build tree.
FROM scratch AS export
COPY --from=builder /ortwheel/ /
